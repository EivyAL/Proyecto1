<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GymVisual.CajaPagos">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="16" RowDefinitions="Auto, *, Auto" ColumnDefinitions="*">
        <!-- Superior: Selección de ítems -->
        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Socio" FontWeight="Bold"/>
                    <ComboBox x:Name="CmbSocio" Width="250"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Plan / Paquete" FontWeight="Bold"/>
                    <ComboBox x:Name="CmbPaquete" Width="250"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Producto" FontWeight="Bold"/>
                    <ComboBox x:Name="CmbProducto" Width="250"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Text="Cantidad" FontWeight="Bold"/>
                    <NumericUpDown x:Name="NumCantidad" Minimum="1" Value="1" Width="80"/>
                </StackPanel>

                <Button Grid.Column="4" Content="Agregar" Width="130" Height="40" Background="#4CAF50" Foreground="White" Click="OnAgregarClick"/>
            </Grid>
        </Border>

        <!-- Central: Carrito de Compras -->
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Carrito de compras" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <DataGrid x:Name="GridCarrito" AutoGenerateColumns="False" Height="320" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/>
                        <DataGridTextColumn Header="Clave" Binding="{Binding Clave}" Width="100"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat={}{0:C}}" Width="100"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}{0:C}}" Width="100"/>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Click="OnEliminarItemClick" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Inferior: Panel de Cobro -->
        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Total a Cobrar" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTotal" FontSize="28" FontWeight="Bold" Text="$0.00"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Total Pagado" FontWeight="Bold"/>
                    <TextBox x:Name="TxtPagado" Text="0" HorizontalAlignment="Stretch" TextChanged="OnPagadoTextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Cambio" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtCambio" FontSize="28" FontWeight="Bold" Text="$0.00"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,20,0,0">
                    <TextBlock Text="Forma de pago" FontWeight="Bold"/>
                    <ComboBox x:Name="CmbFormaPago" SelectedIndex="0">
                        <ComboBoxItem>EFECTIVO</ComboBoxItem>
                        <ComboBoxItem>TARJETA</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4" Margin="0,20,0,0">
                    <TextBlock Text="Nota" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtNota" Text="Pago con Tarjeta" Foreground="#444"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                    <Button Content="Limpiar" Width="120" Background="#9E9E9E" Foreground="White" Click="OnLimpiarClick"/>
                    <Button Content="Confirmar" Width="120" Background="#2196F3" Foreground="White" Click="OnConfirmarPagoClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>